# ── LLM (DeepSeek) ──
# 在 https://platform.deepseek.com 注册获取
LLM_API_KEY=sk-你的deepseek-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ── 深度思考（DeepSeek thinking 模式，默认开启）──
# 开启后，答案生成改用思考模型实时流式返回推理链（reasoning_content），
# 前端在答案上方以「💭 深度思考」面板实时展示，类似 DeepSeek 深度思索。
# LLM_THINKING_MODEL 需为支持 thinking 的模型（deepseek-v4-flash / deepseek-reasoner）。
LLM_THINKING_ENABLED=true
LLM_THINKING_MODEL=deepseek-v4-flash
LLM_THINKING_MODE=thinking
LLM_THINKING_MAX_TOKENS=8192

# ── Embedding (硅基流动) ──
# 在 https://siliconflow.cn 注册获取
EMBEDDING_API_KEY=sk-你的siliconflow-key
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=32

# ── 安全 ──
SECRET_KEY=change-me-to-a-random-string

# ── 上传与检索 ──
MAX_UPLOAD_SIZE_MB=50
API_TIMEOUT_SECONDS=60
MAX_CHAT_WORKERS=4
# 默认只启用语义检索；请先运行离线评测，再按需启用以下功能。
HYBRID_RETRIEVAL_ENABLED=false
RERANKER_ENABLED=false

# ── MCP 工具（可选增强，默认关闭）──
# 开启后 LLM 可通过 function calling 调用外部 MCP 工具（如 fetch 抓网页）。
# 需先安装依赖：pip install mcp mcp-server-fetch
MCP_ENABLED=false
# MCP_SERVER_COMMAND 留空时自动选择：开发=venv python，EXE=python
MCP_SERVER_COMMAND=
MCP_SERVER_ARGS=-m mcp_server_fetch
MCP_CONNECT_TIMEOUT=15
MCP_TOOL_TIMEOUT=60
MCP_MAX_STEPS=3
MCP_TOOL_MAX_TOKENS=300
MCP_TOOL_RESULT_MAX_CHARS=8000

# ── 检索智能体（可选增强，默认关闭）──
# 开启后，检索由 LLM 通过 function calling 自主决定：查什么、查几次、可换词重查
AGENT_RETRIEVAL_ENABLED=false

# ── 检索规划（智能体流水线第 1 步，默认开启）──
# 开启后，先让 LLM 把问题拆成最多 3 个子问题，再逐个子问题检索并合并去重
AGENT_PLANNING_ENABLED=true

# ── 答案自检（智能体流水线最后一步，默认开启）──
# 开启后，答案生成完再让 LLM 对照参考资料质检，跑偏/漏关键点/有错就重写
ANSWER_SELFCHECK_ENABLED=true
